# Don't ship the Claude-artifact variant — it has a hardcoded webhook URL.
# The standalone intake-form.html (which prompts for the webhook URL) is the
# only HTML we want publicly reachable. (Now lives under public/ for the Astro build.)
public/intake/intake-artifact.html

# Don't ship Python builders, Apps Script source, or docs to the static host.
# (These live outside src/ & public/, so the Astro build already omits them —
# excluding them here just keeps them out of the upload.)
deliverables/
webhook/
docs/
samples/
assets/
CHANGELOG.md
README.md
