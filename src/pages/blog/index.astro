---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const fmt = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout
  title="Blog · MRFL Transactions"
  description="Practical guides on Florida real estate transaction coordination — contracts, deadlines, and getting to the closing table without the chaos."
>
  <header class="hero blog-hero" id="top">
    <div class="shell">
      <span class="eyebrow">The MRFL Blog</span>
      <h1>Notes for <em>Florida agents</em>.</h1>
      <p class="sub">Practical guides on contracts, deadlines, and getting to the closing
        table without the chaos.</p>
    </div>
  </header>

  <section>
    <div class="shell">
      {posts.length === 0 ? (
        <div class="revs-empty">New posts coming soon — check back shortly. 🌱</div>
      ) : (
        <div class="post-grid">
          {posts.map((p) => (
            <a class="post-card reveal" href={`/blog/${p.id}/`}>
              <div class="post-meta">
                {fmt(p.data.publishDate)}{p.data.tags.length ? ` · ${p.data.tags[0]}` : ''}
              </div>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="post-more">Read →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
