---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const fmt = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout
  title={`#${tag} · MRFL Transactions Blog`}
  description={`MRFL Transactions blog posts tagged “${tag}” — for Florida real estate agents.`}
>
  <header class="hero blog-hero" id="top">
    <div class="shell">
      <span class="eyebrow">Tagged</span>
      <h1>#{tag}</h1>
      <p class="sub">Posts about {tag} for Florida agents.</p>
    </div>
  </header>

  <section>
    <div class="shell">
      <div class="post-grid">
        {posts.map((p) => (
          <a class="post-card reveal" href={`/blog/${p.id}/`}>
            <div class="post-meta">{fmt(p.data.publishDate)}</div>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="post-more">Read →</span>
          </a>
        ))}
      </div>
      <p style="text-align:center; margin-top:32px;">
        <a class="back-link" href="/blog">← All posts</a>
      </p>
    </div>
  </section>
</BaseLayout>
