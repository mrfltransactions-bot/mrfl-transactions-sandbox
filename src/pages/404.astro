---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found · MRFL Transactions" description="That page doesn't exist.">
  <section class="contact" style="padding-top:90px;">
    <div class="shell">
      <span class="eyebrow">404</span>
      <h2 class="sec">This page took a different closing date.</h2>
      <p class="seclead">The page you're looking for isn't here — but your next deal can still get moving.</p>
      <div class="ctas">
        <a class="btn big" href="/">← Back home</a>
        <a class="btn big ghost" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>
</BaseLayout>
